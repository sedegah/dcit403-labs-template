{
  "name": "Clinic Assistant - Deployed",
  "nodes": [
    {
      "parameters": { "updates": ["message"], "additionalFields": {} },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": { "jsCode": "const chatId = $json.message.chat.id;\nconst text = $json.message.text || '';\nconst hashed = require('crypto').createHash('sha256').update(String(chatId)).digest('hex').slice(0,12);\nreturn [{ json: { chatId, text, chatIdHash: hashed } }];" },
      "id": "extract",
      "name": "Extract & Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": { "method": "POST", "url": "http://localhost:8000/ask", "sendBody": true, "bodyParameters": { "parameters": [{ "name": "question", "value": "={{ $json.text }}" }] }, "options": {} },
      "id": "call-agent",
      "name": "Call Agent API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": { "chatId": "={{ $('Extract & Hash').item.json.chatId }}", "text": "={{ $json.answer }}", "additionalFields": {} },
      "id": "reply",
      "name": "Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Extract & Hash", "type": "main", "index": 0 }]] },
    "Extract & Hash": { "main": [[{ "node": "Call Agent API", "type": "main", "index": 0 }]] },
    "Call Agent API": { "main": [[{ "node": "Reply", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1"
}
